{
  "name": "Workflow 2 — Chat Query (v1)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "options": {}
      },
      "id": "chat-trigger",
      "name": "Chat Trigger (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "rag-chat-query"
    },
    {
      "parameters": {
        "jsCode": "// INPUT: { question: string } from webhook body\n// OUTPUT: cleaned question string\n\nconst question = $input.first().json.question || $input.first().json.body?.question || '';\nreturn [{ json: { question: question.trim() } }];"
      },
      "id": "parse-question",
      "name": "Parse Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.LLM_API_BASE }}/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "body": {
            "contentType": "json",
            "parametersJson": "={\"model\": \"{{ $env.EMBEDDING_MODEL }}\", \"input\": \"{{ $json.question }}\"}"
          }
        }
      },
      "id": "embed-question",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "similaritySearch",
        "tableName": "documents",
        "matchCount": 5,
        "options": {}
      },
      "id": "supabase-search",
      "name": "Supabase Similarity Search",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// INPUT: question + retrieved docs with scores\n// OUTPUT: prompt for LLM with context\n\nconst question = $('Parse Question').first().json.question;\nconst docs = $input.all().map(item => item.json).filter(d => d.content);\n\nconst context = docs.map((d, i) => `[${i + 1}] ${d.metadata?.filename || 'Doc ' + (i + 1)}:\n${d.content.slice(0, 1000)}`).join('\\n\\n');\n\nconst systemPrompt = `Du bist der NovaWork HR Assistant. Antworte NUR mit Informationen aus den bereitgestellten Dokumenten. Wenn die Information nicht in den Dokumenten steht, sage: \"Diese Information liegt mir nicht vor. Bitte wende dich an hr@novawork.de.\"`;\n\nreturn [{\n  json: {\n    question: question,\n    context: context,\n    messages: [\n      { role: 'system', content: systemPrompt },\n      { role: 'user', content: `Frage: ${question}\\n\\nRelevante Dokumente:\\n${context}\\n\\nAntwort:` }\n    ]\n  }\n}];"
      },
      "id": "build-prompt",
      "name": "Build Prompt with Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.LLM_API_BASE }}/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "body": {
            "contentType": "json",
            "parametersJson": "={\"model\": \"{{ $env.LLM_CHAT_MODEL }}\", \"messages\": {{ JSON.stringify($json.messages) }}, \"max_tokens\": 500, \"temperature\": 0.3}"
          }
        }
      },
      "id": "call-llm",
      "name": "Call LLM for Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format the LLM response for the webhook\nconst answer = $input.first().json.choices?.[0]?.message?.content || $input.first().json.content || '';\nconst question = $('Parse Question').first().json.question;\n\nreturn [{\n  json: {\n    question: question,\n    answer: answer,\n    sources: $('Supabase Similarity Search').all().map(d => d.json.metadata?.filename).filter(Boolean),\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Chat Trigger (Webhook)": {
      "main": [[ { "node": "Parse Question", "type": "main", "index": 0 } ]]
    },
    "Parse Question": {
      "main": [[ { "node": "Embed Question", "type": "main", "index": 0 } ]]
    },
    "Embed Question": {
      "main": [[ { "node": "Supabase Similarity Search", "type": "main", "index": 0 } ]]
    },
    "Supabase Similarity Search": {
      "main": [[ { "node": "Build Prompt with Context", "type": "main", "index": 0 } ]]
    },
    "Build Prompt with Context": {
      "main": [[ { "node": "Call LLM for Answer", "type": "main", "index": 0 } ]]
    },
    "Call LLM for Answer": {
      "main": [[ { "node": "Format Response", "type": "main", "index": 0 } ]]
    },
    "Format Response": {
      "main": [[ { "node": "Respond to Webhook", "type": "main", "index": 0 } ]]
    }
  },
  "settings": {
    "saveExecutionProgress": true,
    "callerPolicy": "any"
  }
}
