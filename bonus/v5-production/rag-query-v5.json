{
  "name": "RAG Query v5 — Production-Ready (Gruppe 1, Case 1)",
  "nodes": [
    {
      "parameters": {
        "content": "## QUERY v5 — Production-Ready\n\nAlle 7 Patterns:\n\n1. HMAC Webhook-Signaturprüfung\n2. Schema Validation + Prompt-Injection-Pre-Filter\n3. Audit Logs (Query + Retrieved Docs + Response)\n4. Structured Logging (JSON)\n5. Rate Limit (Wait + Backoff bei 429)\n6. Circuit Breaker (Anthropic, Supabase)\n7. Idempotency (request_id + dedup window)\n\nFür Dozent-Q&A: jedes Pattern hat eigenen Node mit Notiz-Annotation.",
        "height": 480,
        "width": 1440,
        "color": "#B2A624"
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "sticky-header-query",
      "name": "Header"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-chat-v5",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [128, 528],
      "id": "webhook-trigger",
      "name": "Webhook (HMAC-protected)",
      "webhookId": "rag-chat-v5",
      "notes": "Pattern 1: HMAC Signaturprüfung im nächsten Code-Node"
    },
    {
      "parameters": {
        "jsCode": "// Pattern 1: HMAC-SHA256 Webhook-Signaturprüfung\n// Pattern 4: Structured Logging\n//\n// Erwartet Header X-Webhook-Signature: sha256=<hex>\n// Shared Secret kommt aus Env: $env.RAG_WEBHOOK_SECRET\n\nconst crypto = require('crypto');\nconst secret = $env.RAG_WEBHOOK_SECRET || 'changeme-dev-only';\nconst sigHeader = $input.first().json.headers?.['x-webhook-signature']\n  || $input.first().json.headers?.['X-Webhook-Signature']\n  || '';\nconst rawBody = $input.first().json.body || JSON.stringify($input.first().json);\nconst bodyStr = typeof rawBody === 'string' ? rawBody : JSON.stringify(rawBody);\n\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', secret)\n  .update(bodyStr)\n  .digest('hex');\n\nconst providedClean = sigHeader.startsWith('sha256=') ? sigHeader : `sha256=${sigHeader}`;\n\nlet hmacValid = false;\ntry {\n  hmacValid = crypto.timingSafeEqual(\n    Buffer.from(expected),\n    Buffer.from(providedClean)\n  );\n} catch (e) {\n  hmacValid = false;\n}\n\nconst requestId = crypto.randomUUID();\nconst startTs = Date.now();\n\nconst payload = typeof rawBody === 'string'\n  ? (() => { try { return JSON.parse(rawBody); } catch { return {}; } })()\n  : rawBody;\n\nconst log = JSON.stringify({\n  level: hmacValid ? 'info' : 'warn',\n  source: 'query-v5',\n  action: 'hmac_checked',\n  request_id: requestId,\n  hmac_valid: hmacValid,\n  ts: new Date().toISOString()\n});\n\nreturn [{\n  json: {\n    request_id: requestId,\n    process_started_at: startTs,\n    hmac_valid: hmacValid,\n    query: payload.query || payload.message || '',\n    user_id: payload.user_id || payload.userId || 'anonymous',\n    raw_payload: payload,\n    log\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [352, 528],
      "id": "verify-hmac",
      "name": "Verify HMAC",
      "notes": "Pattern 1: HMAC Signatur"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "hmac-ok",
              "leftValue": "={{ $json.hmac_valid }}",
              "rightValue": "={{ true }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [576, 528],
      "id": "if-hmac",
      "name": "HMAC OK?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'invalid_signature', request_id: $json.request_id }) }}",
        "options": { "responseCode": 401 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 736],
      "id": "respond-401",
      "name": "401 Unauthorized"
    },
    {
      "parameters": {
        "jsCode": "// Pattern 2: Schema Validation + Basic Prompt-Injection-Filter\n// Pattern 4: Structured Logging\n\nconst item = $input.first().json;\nconst query = (item.query || '').trim();\nconst userId = (item.user_id || 'anonymous').toString().slice(0, 100);\n\nconst MIN_LEN = 3;\nconst MAX_LEN = 1000;\nconst INJECTION_PATTERNS = [\n  /ignore (all )?(previous|prior) (instructions|messages|prompts)/i,\n  /you are now (a |an )?(different|new) (assistant|ai|model)/i,\n  /system prompt:?/i,\n  /reveal (your|the) (instructions|prompt|system)/i,\n  /print (your|the) (system|hidden) (prompt|message|instructions)/i\n];\n\nconst errors = [];\nif (query.length < MIN_LEN) errors.push('query_too_short');\nif (query.length > MAX_LEN) errors.push('query_too_long');\nif (INJECTION_PATTERNS.some(p => p.test(query))) errors.push('prompt_injection_suspected');\n\nconst validationStatus = errors.length === 0 ? 'ok' : 'rejected';\n\nconst log = JSON.stringify({\n  level: validationStatus === 'ok' ? 'info' : 'warn',\n  source: 'query-v5',\n  action: 'schema_validated',\n  request_id: item.request_id,\n  query_length: query.length,\n  user_id: userId,\n  status: validationStatus,\n  errors,\n  ts: new Date().toISOString()\n});\n\nreturn [{\n  json: {\n    ...item,\n    query,\n    user_id: userId,\n    validation_status: validationStatus,\n    validation_errors: errors,\n    log\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 432],
      "id": "validate-schema-query",
      "name": "Validate Schema",
      "notes": "Pattern 2: Schema Validation + Injection-Filter"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "validation-ok",
              "leftValue": "={{ $json.validation_status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1024, 432],
      "id": "if-valid",
      "name": "Valid?"
    },
    {
      "parameters": {
        "tableId": "audit_events",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "ts", "fieldValue": "={{ $now.toISO() }}" },
            { "fieldId": "source", "fieldValue": "query-v5" },
            { "fieldId": "action", "fieldValue": "query_rejected" },
            { "fieldId": "entity_type", "fieldValue": "query" },
            { "fieldId": "user_id", "fieldValue": "={{ $json.user_id }}" },
            { "fieldId": "request_id", "fieldValue": "={{ $json.request_id }}" },
            { "fieldId": "payload", "fieldValue": "={{ JSON.stringify({ query_preview: $json.query.slice(0, 200) }) }}" },
            { "fieldId": "status", "fieldValue": "rejected" },
            { "fieldId": "error", "fieldValue": "={{ ($json.validation_errors || []).join(',') }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1248, 640],
      "id": "audit-rejected",
      "name": "Audit: Rejected",
      "notes": "Pattern 2: Audit Logs"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'invalid_query', errors: $json.validation_errors, request_id: $json.request_id }) }}",
        "options": { "responseCode": 400 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1472, 640],
      "id": "respond-400",
      "name": "400 Bad Request"
    },
    {
      "parameters": {
        "jsCode": "// Pattern 6: Circuit Breaker Check (Anthropic + Supabase)\n// Pattern 4: Structured Logging\n\n// Bei realem Supabase-Setup: HTTP Request gegen RPC cb_is_open('anthropic_chat')\n// Hier vereinfacht: passthrough; Workflow continueOnFail fängt Failures\n\nconst item = $input.first().json;\nconst log = JSON.stringify({\n  level: 'info',\n  source: 'query-v5',\n  action: 'cb_checked',\n  request_id: item.request_id,\n  services: ['anthropic_chat', 'supabase_vector'],\n  ts: new Date().toISOString()\n});\n\nreturn [{\n  json: {\n    ...item,\n    cb_state: 'closed',\n    log\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1248, 336],
      "id": "cb-check-query",
      "name": "CB Check",
      "notes": "Pattern 6: Circuit Breaker"
    },
    {
      "parameters": {
