            { "fieldId": "entity_type", "fieldValue": "document" },
            { "fieldId": "entity_id", "fieldValue": "={{ $('Validate + Hash').item.json.file_path }}" },
            { "fieldId": "request_id", "fieldValue": "={{ $('Validate + Hash').item.json.request_id }}" },
            { "fieldId": "status", "fieldValue": "error" },
            { "fieldId": "error", "fieldValue": "={{ $json.error?.message || $json.error || 'unknown' }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1936, 544],
      "id": "audit-failed",
      "name": "Audit: Failed",
      "notes": "Pattern 2: Audit Logs — doc_ingestion_failed"
    }
  ],
