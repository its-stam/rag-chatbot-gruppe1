{
  "name": "Workflow 1 — Document Ingestion (v1)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "fileSelector": "/company-docs/final/",
        "options": {}
      },
      "id": "read-files",
      "name": "Read Files from Disk",
      "type": "n8n-nodes-base.readBinaryFiles",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// INPUT: binary file data from previous node\n// OUTPUT: { text: string, metadata: { filename, doctype } }\n\nconst items = $input.all();\nreturn items.map(item => {\n  const filename = item.json.fileName || 'unknown.md';\n  const text = item.json.data || '';\n  return {\n    json: {\n      text: text,\n      metadata: {\n        filename: filename,\n        doctype: filename.split('-')[0] || 'general',\n        chunked_at: new Date().toISOString()\n      }\n    }\n  };\n});"
      },
      "id": "extract-text",
      "name": "Extract Text & Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.LLM_API_BASE }}/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "body": {
            "contentType": "json",
            "parametersJson": "={\"model\": \"{{ $env.EMBEDDING_MODEL }}\", \"input\": \"{{ $json.text.slice(0, 8000) }}\"}"
          }
        }
      },
      "id": "create-embedding",
      "name": "Create Embedding (LLM API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableName": "documents",
        "dataMode": "autoMapInputData",
        "options": {}
      },
      "id": "supabase-insert",
      "name": "Supabase Vector Insert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[ { "node": "Read Files from Disk", "type": "main", "index": 0 } ]]
    },
    "Read Files from Disk": {
      "main": [[ { "node": "Extract Text & Metadata", "type": "main", "index": 0 } ]]
    },
    "Extract Text & Metadata": {
      "main": [[ { "node": "Create Embedding (LLM API)", "type": "main", "index": 0 } ]]
    },
    "Create Embedding (LLM API)": {
      "main": [[ { "node": "Supabase Vector Insert", "type": "main", "index": 0 } ]]
    }
  },
  "settings": {
    "saveExecutionProgress": true,
    "callerPolicy": "any"
  }
}
